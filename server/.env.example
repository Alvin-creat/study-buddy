# ─── Database ────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/studybuddy?schema=public"
REDIS_URL="redis://localhost:6379"

# ─── JWT ────────────────────────────────
JWT_SECRET="your-jwt-secret-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Server ─────────────────────────────
PORT=3000
NODE_ENV=development
CORS_ORIGINS="http://localhost:8080,https://your-domain.com"

# ─── File Storage ───────────────────────
STORAGE_TYPE=s3           # s3 | oss | local
S3_BUCKET=studybuddy-uploads
S3_REGION=ap-southeast-1
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_ENDPOINT=https://s3.amazonaws.com

# Local storage fallback
UPLOAD_DIR=./uploads

# ─── OCR / KYC ──────────────────────────
# Stripe Identity or Alibaba Cloud ID verification
KYC_PROVIDER=stripe       # stripe | aliyun
STRIPE_SECRET_KEY=sk_...
ALIYUN_ACCESS_KEY=...
ALIYUN_SECRET_KEY=...
ALIYUN_OCR_ENDPOINT=https://ocrapi...

# ─── Translation ────────────────────────
TRANSLATION_API_KEY=...
TRANSLATION_ENDPOINT=https://api-free.deepl.com/v2/translate

# ─── Rate Limiting ──────────────────────
RATE_LIMIT_WINDOW_MS=60000       # 1 minute
RATE_LIMIT_MAX=100               # max requests per window
RATE_LIMIT_AUTH_MAX=10           # auth endpoints

# ─── Logging ────────────────────────────
LOG_LEVEL=debug
